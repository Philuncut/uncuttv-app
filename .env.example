# =============================================================================
# UncutTV Streaming Portal — Vorlage fuer .env.local
#
# Kopieren: cp .env.example .env.local  (und Platzhalter ersetzen)
# .env.local wird NIE committed. Diese Datei enthaelt nur Platzhalter.
# =============================================================================

# --- Betriebsmodus ----------------------------------------------------------

# Maintenance-Modus. true = alle oeffentlichen Routen werden auf /maintenance
# umgeleitet ("COMING SOON") und robots.txt liefert `Disallow: /`.
# ACHTUNG: Ist die Variable nicht gesetzt, gilt der Default TRUE (Maintenance an).
# Zum Livegang explizit auf false setzen.
MAINTENANCE_MODE=true

# Veralteter Vorgaenger von MAINTENANCE_MODE, nur noch als Fallback ausgewertet.
# Kann entfernt werden, sobald MAINTENANCE_MODE in allen Environments gesetzt ist.
NEXT_PUBLIC_MAINTENANCE_MODE=true

# --- URLs -------------------------------------------------------------------

# Kanonische Produktionsdomain. Basis fuer OpenGraph, robots.txt und sitemap.xml.
# Ohne Slash am Ende. Fallback im Code: https://uncuttv.app
# NICHT uncuttv.at verwenden — das ist der separate Shop.
NEXT_PUBLIC_SITE_URL=https://uncuttv.app

# Basis-URL fuer Rueckleitungen von Stripe Checkout/Portal und Veriff.
# Lokal http://localhost:3000, in Vercel die jeweilige Deployment-URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------

# Projekt-URL und oeffentlicher Anon-Key (Browser + Middleware, respektiert RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-Role-Key: umgeht RLS. Nur serverseitig, niemals ins Client-Bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mux (Video-Hosting + Playback) ----------------------------------------

# API-Zugangsdaten fuer die Mux-Node-SDK (Asset-Verwaltung).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Signing-Key-Paar fuer signierte Playback-Tokens (/api/mux/token).
# Der Private Key ist base64-kodiert und einzeilig zu hinterlegen.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Mux-Data-Env-Key fuer Playback-Analytics (aktuell nicht im Code verwendet).
NEXT_PUBLIC_MUX_ENV_KEY=

# --- Stripe (Abos) ----------------------------------------------------------

# Publishable Key (Browser) und Secret Key (Server).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Signing-Secret des Webhook-Endpoints /api/stripe/webhook.
# Pro Environment unterschiedlich — Test- und Live-Modus haben eigene Secrets.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price-IDs der beiden Abo-Varianten.
STRIPE_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# --- Veriff (Altersverifikation) -------------------------------------------

NEXT_PUBLIC_VERIFF_API_KEY=
VERIFF_SECRET_KEY=

# --- Resend (Transaktions-Mails) -------------------------------------------

RESEND_API_KEY=re_...

# Absenderadresse. Fallback im Code: noreply@uncuttv.at
RESEND_FROM=noreply@uncuttv.at

# --- Sonstiges --------------------------------------------------------------

# Shared Secret zum Schutz kuenftiger Cron-Routen.
# Aktuell existiert keine Cron-Route — Variable ist reserviert.
# Erzeugen mit: openssl rand -base64 32
CRON_SECRET=
